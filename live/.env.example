# Copy this file to live/.env and fill in real values. live/.env is
# git-ignored (see .gitignore) -- NEVER commit real keys.

# Alpaca paper-trading API keys (from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
