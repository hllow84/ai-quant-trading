__pycache__/
*.pyc
*.pyo
data/cache/
.pytest_cache/
*.parquet

# Large intermediate raw data pulls (per-year Dukascopy bid/ask).
data/raw/
download/

# Merged clean spot CSV is 250 MB — exceeds GitHub's 100 MB limit, kept LOCAL only.
# Reproduce it with scripts/download_xauusd.sh + scripts/merge_xauusd.py.
data/XAUUSD_M1_*_spot_dukascopy.csv
*.csv

# ...but DO track the results CSVs. They are the numeric evidence behind every
# claim in research_log.md and STATE_OF_PLAY.md (all 435 trials), and the whole
# set is ~330 KB. Without these a fresh clone has the conclusions but not the
# data they rest on.
!results/*.csv

# ...and the free BTC on-chain active-address series (section 30): tiny
# (~200 KB), free, no-key, one-command reproducible, and unlike the price
# CSVs it is not derived from a licensed/paid data vendor.
!data/BTC_active_addresses_blockchaininfo.csv

# Live trading secrets and runtime state -- NEVER commit API keys or local state.
.env
live/.env
live/state/

# Order-book capture output (section 30 follow-up infra) -- large, continuously
# growing, and per-deployment; never the collected data itself, only the code
# and docs that produce it. See docs/orderbook_capture_vps_deployment.md.
data/orderbook_capture/

